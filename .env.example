# Copy to .env.local and fill in. Get values from `supabase status` after `supabase start`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Vapi dashboard -> API Keys -> the PUBLIC key (safe client-side; not the
# private VAPI_API_KEY used server-side in edge functions). Powers in-app
# "talk to your AI" browser calls. Optional — those entry points degrade to
# unavailable without it.
EXPO_PUBLIC_VAPI_KEY=replace-me
